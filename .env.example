# Copy to .env and fill in. .env is git-ignored; never put a real key in this file.

# Set ONE key. Gemini is used if both are set (override with LLM_PROVIDER).
GEMINI_API_KEY=your-gemini-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional settings (defaults shown)
LLM_PROVIDER=gemini                 # gemini or anthropic
LLM_MODEL=gemini-3.5-flash          # anthropic default: claude-haiku-5-5
LLM_TIMEOUT_SECONDS=30              # per call
